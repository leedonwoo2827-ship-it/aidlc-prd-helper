# Local preview: no AWS calls until explicitly enabled and configured.
PORT=4319
BEDROCK_ENABLED=false
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
# Human-readable model name only. Never put an ARN or account ID here.
BEDROCK_MODEL_LABEL=
# Local coach via logged-in CLI (OAuth subscription, no API key): claude | codex | bedrock
# claude: run `claude` once and /login.  codex: run `codex login`.
COACH_PROVIDER=
# Optional model override (claude default: sonnet; codex default: CLI default)
COACH_MODEL=
